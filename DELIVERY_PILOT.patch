+import { describe, expect, it, vi } from "vitest";
+import {
+	approvalCommand,
+	canApprove,
+	currentWeek,
+	DeliveryClient,
+} from "./delivery-client";
+import type { Week } from "./delivery-types";
+const success = (data: unknown) => Response.json({ success: true, data });
+const week: Week = {
+	id: "week",
+	workspace_id: "ws",
+	user_id: "person",
+	week_start_date: "2026-10-19",
+	week_start: 1,
+	timezone: "Europe/Amsterdam",
+	state: "submitted",
+	version: 7,
+	revision: 1,
+	entries: [
+		{
+			id: "entry",
+			project_id: "grow",
+			task_id: "task",
+			work_date: "2026-10-20",
+			activity: "qa",
+			minutes: 90,
+			note: "Device QA",
+		},
+	],
+	submission: { at: "now", over_cap: false, cap_minutes: null },
+	approval: null,
+	payment_status: "manual_unrecorded",
+};
+describe("Delivery client safety", () => {
+	it("retries the exact mutation and key after an ambiguous failure, blocking other writes", async () => {
+		const calls: RequestInit[] = [];
+		const send: typeof fetch = async (_input, init) => {
+			calls.push(init!);
+			if (calls.length === 1) throw new Error("Response lost");
+			return success(week);
+		};
+		const client = new DeliveryClient("synthetic-personal-key", send);
+		const body = { action: "save_entry", version: 6 };
+		await expect(client.mutate("POST", "/week/actions", body)).rejects.toThrow(
+			"Response lost",
+		);
+		body.version = 99;
+		await expect(client.mutate("POST", "/different", {})).rejects.toThrow(
+			"Retry",
+		);
+		expect(await client.retry()).toEqual(week);
+		expect(calls[0].body).toEqual(calls[1].body);
+		expect(JSON.parse(String(calls[1].body)).body.version).toBe(6);
+		expect(client.needsRetry).toBe(false);
+	});
+	it("blocks double-clicks while an action is in flight", async () => {
+		let finish!: (value: Response) => void;
+		const send = vi.fn<typeof fetch>(
+			() =>
+				new Promise((resolve) => {
+					finish = resolve;
+				}),
+		);
+		const client = new DeliveryClient("synthetic-key-value", send);
+		const pending = client.mutate("POST", "/week", {});
+		await expect(client.retry()).rejects.toThrow("already running");
+		finish(success(week));
+		await pending;
+		expect(send).toHaveBeenCalledTimes(1);
+	});
+	it("clears definitively rejected writes and discards credentials on disconnect", async () => {
+		const send = vi.fn<typeof fetch>(async () =>
+			Response.json(
+				{
+					success: false,
+					error: { code: "VERSION_CONFLICT", message: "Reload" },
+				},
+				{ status: 409 },
+			),
+		);
+		const client = new DeliveryClient("synthetic-key-value", send);
+		await expect(client.mutate("POST", "/week", {})).rejects.toThrow("Reload");
+		expect(client.needsRetry).toBe(false);
+		client.disconnect();
+		await expect(client.get("/v1/me")).rejects.toThrow("Reconnect");
+		expect(send).toHaveBeenCalledTimes(1);
+	});
+	it("reads every page and detects repeated cursors", async () => {
+		let count = 0;
+		const client = new DeliveryClient("synthetic-key-value", async () =>
+			success({
+				weeks: [++count],
+				pagination: { has_more: count === 1, next_cursor: "cursor" },
+			}),
+		);
+		expect(await client.all("/weeks?from=x", "weeks")).toEqual([1, 2]);
+		const broken = new DeliveryClient("synthetic-key-value", async () =>
+			success({
+				weeks: [],
+				pagination: { has_more: true, next_cursor: "same" },
+			}),
+		);
+		await expect(broken.all("/weeks", "weeks")).rejects.toThrow(
+			"Too many records",
+		);
+	});
+	it("keeps calendar dates stable around Amsterdam DST and midnight", () => {
+		expect(
+			currentWeek("Europe/Amsterdam", 1, new Date("2026-10-25T23:30:00Z")),
+		).toBe("2026-10-26");
+		expect(
+			currentWeek("Europe/Amsterdam", 1, new Date("2026-10-24T23:30:00Z")),
+		).toBe("2026-10-19");
+	});
+	it("forbids self approval and enforces deliberate reductions without mutating submitted entries", () => {
+		expect(canApprove(week, "person", true)).toBe(false);
+		expect(canApprove(week, "owner", false)).toBe(false);
+		expect(canApprove(week, "owner", true)).toBe(true);
+		for (const minutes of ["", "-1", "91", "1.5"])
+			expect(() =>
+				approvalCommand(week, { entry: minutes }, "reason", false),
+			).toThrow();
+		expect(() => approvalCommand(week, { entry: "60" }, "", false)).toThrow(
+			"Explain",
+		);
+		expect(
+			approvalCommand(week, { entry: "60" }, "Duplicate half hour", false),
+		).toEqual({
+			action: "approve",
+			version: 7,
+			entries: [{ entry_id: "entry", approved_minutes: 60 }],
+			reason: "Duplicate half hour",
+		});
+		expect(week.entries[0].minutes).toBe(90);
+	});
+});
diff --git a/apps/web/src/react-app/delivery-client.ts b/apps/web/src/react-app/delivery-client.ts
new file mode 100644
--- /dev/null
+++ b/apps/web/src/react-app/delivery-client.ts
@@ -0,0 +1,204 @@
+import type { Page, Week } from "./delivery-types";
+
+type Command = {
+	method: "POST" | "PUT";
+	path: string;
+	body: Record<string, unknown>;
+	idempotency_key: string;
+};
+export class DeliveryError extends Error {
+	constructor(
+		message: string,
+		readonly status = 0,
+		readonly code = "NETWORK_ERROR",
+	) {
+		super(message);
+	}
+}
+// One instance per connection, private key in memory only. No persistent storage.
+export class DeliveryClient {
+	private pending: Command | null = null;
+	private running = false;
+	private controller = new AbortController();
+	constructor(
+		private key: string,
+		private readonly send: typeof fetch = (...args) => fetch(...args),
+	) {}
+	get needsRetry() {
+		return this.pending !== null;
+	}
+	disconnect() {
+		this.key = "";
+		this.pending = null;
+		this.controller.abort();
+	}
+	private async request<T>(envelope: {
+		method: string;
+		path: string;
+		body?: unknown;
+		idempotency_key?: string;
+	}): Promise<T> {
+		if (!this.key) throw new DeliveryError("Reconnect to Todoless.", 401);
+		const response = await this.send("/api/delivery/request", {
+			method: "POST",
+			credentials: "same-origin",
+			cache: "no-store",
+			headers: {
+				"content-type": "application/json",
+				"x-todoless-key": this.key,
+			},
+			body: JSON.stringify(envelope),
+			signal: AbortSignal.any([
+				this.controller.signal,
+				AbortSignal.timeout(25_000),
+			]),
+		});
+		if (
+			response.ok &&
+			response.headers.get("content-type")?.includes("text/csv")
+		)
+			return (await response.text()) as T;
+		let value: {
+			success?: boolean;
+			data?: T;
+			error?: { code?: string; message?: string };
+		};
+		try {
+			value = await response.json();
+		} catch {
+			throw new DeliveryError(
+				"Unexpected response. Retry the same action.",
+				502,
+			);
+		}
+		if (!response.ok || value.success !== true)
+			throw new DeliveryError(
+				value.error?.message ?? "Delivery request failed.",
+				response.status,
+				value.error?.code,
+			);
+		return value.data as T;
+	}
+	get<T>(path: string) {
+		return this.request<T>({ method: "GET", path });
+	}
+	async all<T>(path: string, field: string): Promise<T[]> {
+		const result: T[] = [];
+		let cursor: string | null = null;
+		const seen = new Set<string>();
+		do {
+			const data: Page & Record<string, unknown> = await this.get(
+				`${path}${path.includes("?") ? "&" : "?"}limit=100${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ""}`,
+			);
+			result.push(...(data[field] as T[]));
+			cursor = data.pagination?.has_more ? data.pagination.next_cursor : null;
+			if (
+				(data.pagination?.has_more && (!cursor || seen.has(cursor))) ||
+				result.length > 5000
+			)
+				throw new DeliveryError("Too many records. Narrow the selected range.");
+			if (cursor) seen.add(cursor);
+		} while (cursor);
+		return result;
+	}
+	async mutate<T>(
+		method: "POST" | "PUT",
+		path: string,
+		body: Record<string, unknown>,
+	): Promise<T> {
+		if (this.pending)
+			throw new DeliveryError("Retry the pending action first.");
+		this.pending = {
+			method,
+			path,
+			body: structuredClone(body),
+			idempotency_key: crypto.randomUUID(),
+		};
+		return this.retry<T>();
+	}
+	async retry<T>(): Promise<T> {
+		if (this.running || !this.pending)
+			throw new DeliveryError(
+				"An action is already running, or there is nothing to retry.",
+			);
+		this.running = true;
+		try {
+			const result = await this.request<T>(this.pending);
+			this.pending = null;
+			return result;
+		} catch (error) {
+			// Definitive rejections cannot have committed. Unknown outcomes keep the exact command/key.
+			if (
+				error instanceof DeliveryError &&
+				((error.status >= 400 && error.status < 500) ||
+					error.code === "DELIVERY_NOT_CONFIGURED")
+			)
+				this.pending = null;
+			throw error;
+		} finally {
+			this.running = false;
+		}
+	}
+}
+export function addDays(date: string, days: number) {
+	const value = new Date(`${date}T12:00:00Z`);
+	value.setUTCDate(value.getUTCDate() + days);
+	return value.toISOString().slice(0, 10);
+}
+export function hours(minutes: number) {
+	return `${Math.floor(minutes / 60)}h ${minutes % 60}m`;
+}
+export function currentWeek(timezone: string, start: number, now = new Date()) {
+	const parts = new Intl.DateTimeFormat("en-CA", {
+		timeZone: timezone,
+		year: "numeric",
+		month: "2-digit",
+		day: "2-digit",
+	}).formatToParts(now);
+	const part = (name: string) => parts.find((p) => p.type === name)!.value;
+	const date = `${part("year")}-${part("month")}-${part("day")}`;
+	return addDays(
+		date,
+		-((new Date(`${date}T12:00:00Z`).getUTCDay() - start + 7) % 7),
+	);
+}
+export function canApprove(week: Week, userId: string, approver: boolean) {
+	return approver && week.user_id !== userId && week.state === "submitted";
+}
+export function approvalCommand(
+	week: Week,
+	minutes: Record<string, string>,
+	reason: string,
+	overCap: boolean,
+) {
+	const entries = week.entries.map((entry) => ({
+		entry_id: entry.id,
+		approved_minutes: Number(minutes[entry.id] ?? entry.minutes),
+	}));
+	if (
+		entries.some(
+			(entry, index) =>
+				!Number.isInteger(entry.approved_minutes) ||
+				entry.approved_minutes < 0 ||
+				entry.approved_minutes > week.entries[index].minutes ||
+				minutes[entry.entry_id]?.trim() === "",
+		)
+	)
+		throw new Error(
+			"Approved minutes must be whole minutes between zero and the submitted amount.",
+		);
+	if (
+		entries.some(
+			(entry, index) => entry.approved_minutes !== week.entries[index].minutes,
+		) &&
+		!reason.trim()
+	)
+		throw new Error("Explain the adjustment before approving.");
+	return {
+		action: "approve",
+		version: week.version,
+		entries,
+		...(reason.trim() ? { reason: reason.trim() } : {}),
+		...(overCap ? { over_cap_decision: "approve" } : {}),
+	};
+}
