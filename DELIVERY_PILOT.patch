+						`/v1/workspaces/${workspace.id}/tasks?project_id=${project}`,
+						"tasks",
+					)
+				: Promise.resolve([]),
+		[client, workspace.id, project],
+	);
+	const { data: tasks, error } = useDeliveryResource(load, project);
+	return (
+		<form
+			className="delivery-form delivery-entry-form"
+			onSubmit={(event) => {
+				event.preventDefault();
+				const form = event.currentTarget;
+				const data = new FormData(form);
+				void run(async () => {
+					await client.mutate(
+						"POST",
+						`/v1/workspaces/${workspace.id}/time/weeks/${week.id}/actions`,
+						{
+							action: "save_entry",
+							version: week.version,
+							...(editing ? { entry_id: editing.id } : {}),
+							entry: {
+								project_id: project,
+								task_id: data.get("task"),
+								work_date: data.get("date"),
+								activity: data.get("activity"),
+								minutes: Number(data.get("minutes")),
+								note: data.get("note"),
+								evidence_ref: data.get("evidence") || null,
+							},
+						},
+					);
+					close();
+				});
+			}}
+		>
+			<h3>{editing ? "Edit time entry" : "Log human time"}</h3>
+			<div className="delivery-fields">
+				<label>
+					Project
+					<select
+						aria-label="Project"
+						required
+						value={project}
+						onChange={(e) => setProject(e.target.value)}
+					>
+						<option value="">Choose a project</option>
+						{projects.map((p) => (
+							<option key={p.id} value={p.id}>
+								{p.name}
+							</option>
+						))}
+					</select>
+				</label>
+				<label>
+					Task
+					<select
+						aria-label="Task"
+						name="task"
+						required
+						key={project}
+						defaultValue={
+							editing?.project_id === project ? editing.task_id : ""
+						}
+						disabled={!tasks || tasks.length === 0}
+					>
+						<option value="">
+							{project ? "Choose a task" : "Choose a project first"}
+						</option>
+						{tasks?.map((t) => (
+							<option key={t.id} value={t.id}>
+								{t.title}
+							</option>
+						))}
+					</select>
+				</label>
+				<label>
+					Work date
+					<input
+						name="date"
+						type="date"
+						required
+						min={week.week_start_date}
+						max={addDays(week.week_start_date, 6)}
+						defaultValue={editing?.work_date ?? week.week_start_date}
+					/>
+				</label>
+				<label>
+					Minutes
+					<input
+						name="minutes"
+						type="number"
+						required
+						min={1}
+						max={1440}
+						step={1}
+						defaultValue={editing?.minutes}
+						placeholder="e.g. 90"
+					/>
+				</label>
+				<label>
+					Activity
+					<select
+						aria-label="Activity"
+						name="activity"
+						defaultValue={editing?.activity ?? "development"}
+					>
+						{["development", "qa", "setup", "research", "rework", "review"].map(
+							(a) => (
+								<option key={a}>{a}</option>
+							),
+						)}
+					</select>
+				</label>
+			</div>
+			{error && <p role="alert">{error}</p>}
+			<label>
+				What did you work on?
+				<textarea
+					name="note"
+					required
+					maxLength={1000}
+					defaultValue={editing?.note}
+				/>
+			</label>
+			<label>
+				Evidence link (optional)
+				<input
+					name="evidence"
+					type="url"
+					pattern="https?://.*"
+					maxLength={2000}
+					defaultValue={editing?.evidence_ref ?? ""}
+				/>
+			</label>
+			<div className="delivery-actions">
+				<button className="button button--primary" disabled={!tasks?.length}>
+					Save time
+				</button>
+				<button type="button" className="text-button" onClick={close}>
+					Cancel
+				</button>
+			</div>
+		</form>
+	);
+}
+function WeekDetail({
